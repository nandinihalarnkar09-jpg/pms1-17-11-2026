# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. NEVER commit real keys.
# Add the same variables in Vercel: Project -> Settings -> Environment Variables.

# Clerk (dashboard.clerk.com -> your app -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Supabase (Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" key. Safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# The secret key (sb_secret_...) or the legacy "service_role" key. SERVER ONLY.
# Used for exactly one job: linking a new login to its employee row.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Resend (resend.com -> API Keys). SERVER ONLY.
RESEND_API_KEY=re_xxx
# Optional. On a free Resend account keep the default test sender.
# EMAIL_FROM=PMS <onboarding@resend.dev>
